# Public production URL
NEXT_PUBLIC_SITE_URL=https://injectoxclinic.co.uk

# Resend transactional email
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=Injectox Clinic <bookings@injectoxclinic.co.uk>
ADMIN_NOTIFICATION_EMAIL=injectoxclinic@gmail.com

# Brevo newsletter API
BREVO_API_KEY=
BREVO_LIST_ID=

# Single-owner admin gate
ADMIN_PASSWORD=replace_with_a_long_unique_password

# Neon Postgres content store (required for shared admin edits and reviews)
DATABASE_URL=

# Optional Vercel KV / Upstash Redis store for globally shared rate limiting.
# Content and reviews use Neon when DATABASE_URL is present.
KV_REST_API_URL=
KV_REST_API_TOKEN=
